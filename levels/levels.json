          "id": "2-1",
          "name": "Dakkapel aanvragen",
          "note": "Welstandscommissie vergadert. Archiveer intussen alles.",
          "map": [
            "##############",
            "#bc  #      p#",
            "# $$ #  #    #",
            "#@$     #  . #",
