{
  "version": 1,
  "departments": [
    {
      "id": 1,
      "name": "Burgerzaken",
      "motto": "Trek een nummertje en neem plaats.",
      "levels": [
        {
          "id": "1-1",
          "name": "Uw eerste aanvraag",
          "note": "Breng het dossier naar het archief. Eén formulier, één loket.",
          "map": [
            "###########",
            "#p   #   k#",
            "# $       #",
            "#  @    . #",
            "#         #",
            "#bc     bc#",
            "###########"
          ]
        },
        {
          "id": "1-2",
          "name": "Paspoort verlopen",
          "note": "Twee aanvragen, twee archiefplekken. Neem een nummertje.",
          "map": [
            "############",
            "#a   #    p#",
            "#    #$    #",
            "#  .   @   #",
            "#    #$  . #",
            "#bc  #   bc#",
            "############"
          ]
        },
        {
          "id": "1-3",
          "name": "Verhuizing doorgeven",
          "note": "Uw nieuwe adres is bij ons bekend. Uw dossiers nog niet.",
          "map": [
            "#############",
            "#k    #    p#",
            "#  .  #   $ #",
            "#  .     @  #",
            "#     #     #",
            "#bc   ## $###",
            "#          a#",
            "#############"
          ]
        },
        {
          "id": "1-4",
          "name": "Rijbewijs ophalen",
          "note": "Vergeet uw pasfoto niet. Of uw dossiers.",
          "map": [
            "#############",
            "#p   ###   a#",
            "#         $ #",
            "#  ...  @ $ #",
            "#        $  #",
            "###  #b#  ###",
            "#k         r#",
            "#############"
          ]
        }
      ]
    },
    {
      "id": 2,
      "name": "Vergunningen",
      "motto": "Voor het aanvragen van een vergunning is een vergunning vereist.",
      "levels": [
